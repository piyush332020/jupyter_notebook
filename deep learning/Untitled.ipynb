   "source": [
    " def step(x):\n",
    "     return 1 if x>=0 else 0\n",
    "def perceptron(x1,x2,w1,w2,b):\n",
    "    y=x1*w1+x2*w2+b\n",
    "    return step(y)\n",
    "print(perceptron(0,0))"
   ]
  }
